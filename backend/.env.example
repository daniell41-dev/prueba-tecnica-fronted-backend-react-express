# Copia este archivo a `.env` para desarrollo local (fuera de Docker).
# Dentro de docker-compose, estas mismas variables se definen como `environment:`
# del servicio `api` en el `docker-compose.yml` de la raíz.

NODE_ENV=development
PORT=3000

# Cadena de conexión completa a PostgreSQL. Dentro de Docker el host es el
# nombre del servicio (`db`), no `localhost` — ver docs/07-docker-desktop.md.
DATABASE_URL=postgres://contacts:contacts@localhost:5432/contacts

# Firma de los JWT. Mínimo 32 caracteres (se valida en config/env.ts). Nunca
# se sube un secreto real a git; este es solo para desarrollo.
JWT_SECRET=cambia-este-secreto-de-desarrollo-por-uno-real-32+
JWT_EXPIRES_IN=1h

# Orígenes permitidos por CORS para el frontend en dev (Vite).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Cliente externo usado por POST /api/contacts/import (Promise.allSettled + timeout).
RANDOM_USER_API_URL=https://randomuser.me/api/
RANDOM_USER_TIMEOUT_MS=5000

# Si es "true", las respuestas 500 incluyen el detalle del error (nunca en producción).
APP_DEBUG=true
