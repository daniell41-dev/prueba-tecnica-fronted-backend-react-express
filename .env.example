# Copia este archivo a `.env` en la raíz antes de `docker compose up`.
# docker-compose.yml lee estas variables para los tres servicios.

# --- Postgres (servicio "db") ---
POSTGRES_USER=contacts
POSTGRES_PASSWORD=contacts
POSTGRES_DB=contacts

# --- API (servicio "api") ---
# Mínimo 32 caracteres. Nunca subas un secreto real a git.
JWT_SECRET=cambia-este-secreto-por-uno-real-de-32-caracteres+
JWT_EXPIRES_IN=1h
CORS_ALLOWED_ORIGIN=http://localhost:8080
RANDOM_USER_API_URL=https://randomuser.me/api/
RANDOM_USER_TIMEOUT_MS=5000
APP_DEBUG=false
