              "path": [
                "api",
                "contacts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"email\": \"ada.postman.{{$timestamp}}@example.com\",\n  \"company\": \"Analytical Engine\",\n  \"favorite\": true,\n  \"phones\": [\n    {\n      \"type\": \"mobile\",\n      \"number\": \"+52 55 1111 2222\"\n    },\n    {\n      \"type\": \"work\",\n      \"number\": \"5533334444\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('trae header Location', () => pm.expect(pm.response.headers.has('Location')).to.be.true);",
                  "const body = pm.response.json();",
                  "pm.test('el teléfono queda normalizado a 10 dígitos', () => pm.expect(body.contact.phones[0].number).to.eql('5511112222'));",
                  "pm.environment.set('contact_id', body.contact.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
